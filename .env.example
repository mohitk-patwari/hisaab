# Hisaab LLM configuration.  Copy to .env (gitignored) and fill in ONE key.
# This file is committed with no real values; .env is not.

# Which backend the intent parser and narrator use: gemini | anthropic | groq | offline
# If unset, the first provider below whose key is present is used; if none, offline
# (the deterministic regex stub -- the pipeline still runs, with no network).
# Pick one. Gemini free tier: https://aistudio.google.com/apikey
HISAAB_LLM_PROVIDER=gemini

# gemini    -> generativelanguage.googleapis.com, model gemini-3.6-flash
GEMINI_API_KEY=paste-your-key-here

# anthropic -> api.anthropic.com/v1/messages, model claude-sonnet-4-6
# ANTHROPIC_API_KEY=

# groq      -> api.groq.com/openai/v1/chat/completions, model llama-3.3-70b-versatile
# GROQ_API_KEY=

# Milliseconds slept before every LLM request, so a 300-question run does not
# rate-limit itself on a free tier. Default 100.
HISAAB_LLM_DELAY_MS=100

# Optional model overrides (defaults shown). Set GEMINI_MODEL if the default
# stops being served to new keys -- a stale default must never silently break
# the run again (that is exactly what gemini-2.5-flash did: 404, not a 429).
# GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_MODEL=claude-sonnet-4-6
# GROQ_MODEL=llama-3.3-70b-versatile
